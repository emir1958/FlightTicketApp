@using FlightTicketApp.Shared.DTOs
@model Tuple<FlightDto, string>

@{
    var flight = Model.Item1;
    var type = Model.Item2;
    var depTime = flight.DepartureDateTime.ToString("HH:mm");
    var arrTime = flight.ArrivalDateTime.ToString("HH:mm");

    var uniqueModalId = $"flightModal-{flight.FlightNumber.Replace(" ", "")}-{flight.Origin}-{flight.Destination}";
}

<div class="card border shadow-sm rounded-3 mb-3">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="badge @(type == "Gidiş" ? "bg-primary" : "bg-success")">@type Uçuşu</span>
            <span class="fw-bold text-muted">@flight.FlightNumber</span>
        </div>
        <div class="row align-items-center text-center my-3">
            <div class="col-4">
                <h4 class="mb-0 fw-bold">@depTime</h4>
                <span class="badge bg-light text-dark border">@flight.Origin</span>
            </div>
            <div class="col-4 text-muted">
                <i class="bi bi-airplane fs-5"></i>
                <div class="small">Direkt</div>
            </div>
            <div class="col-4">
                <h4 class="mb-0 fw-bold">@arrTime</h4>
                <span class="badge bg-light text-dark border">@flight.Destination</span>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center border-top pt-2">
            <div class="fs-4 fw-bold text-dark">@flight.Price ₺</div>
            <button type="button" class="btn btn-outline-primary btn-sm px-3 fw-semibold"
                    data-bs-toggle="modal"
                    data-bs-target="#@uniqueModalId">
                Detayları İncele
            </button>
        </div>
    </div>
</div>

<div class="modal fade" id="@uniqueModalId" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-ticket-perforated me-2"></i>Uçuş Detayı</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info py-2 mb-3">
                    <strong>@type Seferi Detayları</strong>
                </div>
                <ul class="list-group list-group-flush mb-3">
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Uçuş Numarası:</span>
                        <span class="fw-bold">@flight.FlightNumber</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Kalkış:</span>
                        <span class="fw-bold">@flight.Origin - @flight.DepartureDateTime.ToString("dd.MM.yyyy HH:mm")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Varış:</span>
                        <span class="fw-bold">@flight.Destination - @flight.ArrivalDateTime.ToString("dd.MM.yyyy HH:mm")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between bg-light">
                        <span class="fw-bold fs-5">Fiyat:</span>
                        <span class="fw-bold fs-5 text-success">@flight.Price ₺</span>
                    </li>
                </ul>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary w-100 fw-semibold" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>